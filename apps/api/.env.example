# BACKEND ENVIRONMENT VARIABLES
# For Railway deployment, these are set in the Railway dashboard variables panel
# (except DATABASE_URL which is auto-injected from PostgreSQL plugin)

# ────────────────────────────────────────────────────────────────────
# DATABASE (Auto-provided by Railway PostgreSQL plugin)
# Do NOT set this manually in Railway - it's auto-injected
# ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ────────────────────────────────────────────────────────────────────
# JWT SECRETS (Required - Generate strong random strings in production)
# Use: openssl rand -base64 32
# ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-secret-access-key-here-min-32chars
JWT_REFRESH_SECRET=your-secret-refresh-key-here-min-32chars

# ────────────────────────────────────────────────────────────────────
# API BASE URL (Self URL for returned file paths and Swagger docs)
# PRODUCTION (Railway): https://teamflow-api.up.railway.app
# ────────────────────────────────────────────────────────────────────
API_URL=http://localhost:5000

# ────────────────────────────────────────────────────────────────────
# FRONTEND URL(S) (For CORS and Socket.io)
# PRODUCTION (Railway): https://teamflow-web.up.railway.app
# Multiple origins supported (comma-separated):
# CLIENT_URL=https://teamflow-web.up.railway.app,https://teamflow-web-preview.up.railway.app
# ────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────────
# CLOUDINARY (File upload service)
# Get these from: https://cloudinary.com/console
# ────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ────────────────────────────────────────────────────────────────────
# SERVER PORT (Railway auto-assigns this - leave empty)
# ────────────────────────────────────────────────────────────────────
# PORT=  (Auto-set by Railway, do not override)
